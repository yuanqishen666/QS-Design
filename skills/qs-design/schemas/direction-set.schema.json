{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qs.design/schemas/direction-set.schema.json",
  "title": "QS Design Direction Set",
  "type": "object",
  "required": ["schema", "task_id", "count", "reason", "comparison_frame", "directions"],
  "properties": {
    "schema": {"const": 1},
    "task_id": {"type": "string", "pattern": "^task-[a-z0-9-]+$"},
    "count": {"type": "integer", "minimum": 1},
    "reason": {"type": "string", "minLength": 1},
    "cost_notice": {"type": ["string", "null"]},
    "comparison_frame": {"type": "array", "items": {"type": "string"}},
    "directions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "thesis", "business_signature", "information_topology", "interaction_model", "art_direction", "dominant_decisions", "craft_review", "generality_tests", "non_transferability", "platform_expressions", "evidence", "risks"],
        "properties": {
          "id": {"type": "string"},
          "thesis": {"type": "string"},
          "business_signature": {"type": "string"},
          "information_topology": {"type": "string"},
          "interaction_model": {"type": "string"},
          "art_direction": {"type": "object"},
          "dominant_decisions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["user_effect", "expression", "remove_test"],
              "properties": {
                "business_basis": {"type": "string"},
                "art_direction_basis": {"type": "string"},
                "brand_basis": {"type": "string"},
                "platform_basis": {"type": "string"},
                "user_effect": {"type": "string", "minLength": 1},
                "expression": {"type": "string", "minLength": 1},
                "remove_test": {"type": "string", "minLength": 1}
              },
              "anyOf": [
                {"required": ["business_basis"]},
                {"required": ["art_direction_basis"]},
                {"required": ["brand_basis"]},
                {"required": ["platform_basis"]}
              ],
              "additionalProperties": true
            }
          },
          "craft_review": {"type": "object"},
          "generality_tests": {"type": "object"},
          "non_transferability": {"type": "string"},
          "platform_expressions": {"type": "object"},
          "evidence": {"type": "array"},
          "risks": {"type": "array"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
