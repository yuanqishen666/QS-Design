{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qs.design/schemas/prototype-contract.schema.json",
  "title": "QS Design Prototype Contract",
  "type": "object",
  "required": ["schema", "task_id", "fidelity", "coverage_scope", "purpose", "required_paths", "required_states", "data_fixture", "fixture_source", "viewports", "evidence_requirements", "path_evidence", "critique_policy", "critique_cycles", "prohibited_claims"],
  "properties": {
    "schema": {"const": 1},
    "task_id": {"type": "string", "pattern": "^task-[a-z0-9-]+$"},
    "fidelity": {"enum": ["specimen", "static", "clickable", "native"]},
    "coverage_scope": {"enum": ["representative", "full-product"]},
    "purpose": {"type": "string", "minLength": 1},
    "required_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start", "steps", "outcome"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "start": {"type": "string", "minLength": 1},
          "steps": {"type": "array", "items": {"type": "object", "required": ["index", "action_id", "target_id", "expected_state"], "properties": {"index": {"type": "integer", "minimum": 1}, "action_id": {"type": "string"}, "target_id": {"type": "string"}, "expected_state": {"type": "string"}}, "additionalProperties": false}},
          "outcome": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "required_states": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "data_fixture": {"type": "object"},
    "fixture_source": {"type": "string", "minLength": 1},
    "viewports": {"type": "array", "items": {"type": "object", "required": ["id", "platform", "width", "height", "device"], "properties": {"id": {"type": "string"}, "platform": {"type": "string"}, "width": {"type": ["number", "null"]}, "height": {"type": ["number", "null"]}, "device": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "evidence_requirements": {"type": "array", "items": {"enum": ["rendered-artifact", "runtime-flow", "step-capture", "assertion-report", "accessibility-tree", "native-capture"]}, "uniqueItems": true},
    "path_evidence": {"type": "array", "items": {"$ref": "attention-contract.schema.json#/$defs/evidence"}},
    "critique_policy": {"type": "object", "required": ["require_render_inspect_diagnose_rerun", "max_internal_corrections", "stop_for_user_after_limit"], "properties": {"require_render_inspect_diagnose_rerun": {"type": "boolean"}, "max_internal_corrections": {"type": "integer", "minimum": 0, "maximum": 3}, "stop_for_user_after_limit": {"type": "boolean"}}, "additionalProperties": false},
    "critique_cycles": {"type": "array", "items": {"type": "object", "required": ["render_ref", "diagnosis", "targeted_change", "rerun_ref"], "properties": {"render_ref": {"type": "string"}, "diagnosis": {"type": "string"}, "targeted_change": {"type": "string"}, "rerun_ref": {"type": "string"}}, "additionalProperties": true}},
    "prohibited_claims": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
