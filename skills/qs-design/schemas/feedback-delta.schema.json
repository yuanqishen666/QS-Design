{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qs.design/schemas/feedback-delta.schema.json",
  "title": "QS Design Feedback Delta",
  "type": "object",
  "required": ["schema", "delta_id", "source_verbatim", "observed_problem", "user_goal", "diagnosed_cause", "diagnosis_confidence", "preserve", "change", "do_not_infer", "next_experiment", "recommended_relation", "scope", "explicit_consent", "reset_authority"],
  "properties": {
    "schema": {"const": 1},
    "delta_id": {"type": "string", "pattern": "^feedback-delta-[a-z0-9-]+$"},
    "source_verbatim": {"type": "string", "minLength": 1},
    "observed_problem": {"type": "string", "minLength": 1},
    "user_goal": {"type": "string", "minLength": 1},
    "diagnosed_cause": {"type": "string", "minLength": 1},
    "diagnosis_confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "preserve": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "change": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "do_not_infer": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "next_experiment": {"type": "object", "required": ["hypothesis", "change_scope", "expected_observation", "required_evidence"], "properties": {"hypothesis": {"type": "string", "minLength": 1}, "change_scope": {"enum": ["targeted", "representative-flow", "full-product"]}, "expected_observation": {"type": "string", "minLength": 1}, "required_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false},
    "recommended_relation": {"enum": ["continue-parent", "aspect-inheritance", "explicit-merge", "soft-reset", "hard-reset"]},
    "scope": {"enum": ["candidate", "task", "session", "project", "profile"]},
    "explicit_consent": {"type": "boolean"},
    "reset_authority": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
